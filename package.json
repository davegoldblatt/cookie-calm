{
  "name": "cookie-calm",
  "version": "1.2.6",
  "description": "Reject optional cookies and automatically dismiss supported promotional popups. Local rules, protected forms, and per-site pause.",
  "license": "MIT",
  "repository": "https://github.com/davegoldblatt/cookie-calm",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:safari": "node scripts/build.mjs --browser=safari",
    "package:safari": "npm run build:safari && python3 scripts/package-safari.py",
    "test:safari-package": "node --test scripts/tests/safari-package.test.mjs",
    "test:webkit": "npm run build:safari && playwright test --config=playwright.safari.config.js",
    "test": "npm run build && playwright test",
    "package": "npm run build && python3 scripts/package.py",
    "store-assets": "node scripts/store-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  }
}
